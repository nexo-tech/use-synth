{
  "name": "use-synth",
  "version": "0.1.0",
  "description": "Browser-based subtractive synthesizer React hook with advanced modulation",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "bun test",
    "clean": "rm -rf dist node_modules .turbo"
  },
  "keywords": [
    "react",
    "hook",
    "synthesizer",
    "audio",
    "webaudio",
    "midi",
    "modulation"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.0.0",
    "tsup": "^8.0.0",
    "eslint": "^8.0.0",
    "bun-types": "latest"
  }
} 